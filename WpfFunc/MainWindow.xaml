<Window x:Class="WpfFunc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WpfFunc.Views"
        xmlns:loc="clr-namespace:WpfFunc.Localization"
        Title="{loc:Loc Key=App.Title}"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Панель выбора языка -->
        <Border Background="{StaticResource AppPrimaryBrush}"
                DockPanel.Dock="Top"
                Padding="10">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">
                <TextBlock Text="{loc:Loc Key=Language.Caption}"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox Width="150"
                          ItemsSource="{Binding Languages}"
                          SelectedItem="{Binding SelectedLanguage}"
                          DisplayMemberPath="NativeName" />
            </StackPanel>
        </Border>

        <Grid>
            <TabControl>
                <TabItem Header="{loc:Loc Key=Tab.DefaultBinding}">
                <views:DefaultBindingView />
            </TabItem>
                <TabItem Header="{loc:Loc Key=Tab.TwoWayBinding}">
                <views:TwoWayBindingView />
            </TabItem>
                <TabItem Header="{loc:Loc Key=Tab.OneTimeBinding}">
                <views:OneTimeBindingView />
            </TabItem>
                <TabItem Header="{loc:Loc Key=Tab.OneWayBinding}">
                <views:OneWayBindingView />
            </TabItem>
                <TabItem Header="{loc:Loc Key=Tab.Triggers}">
                <views:TriggersView />
            </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>