<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Те же ключи, что и в RESX, но реализованы через XAML-словарь -->

    <!-- Общие -->
    <x:String x:Key="App.Title">ЛР1 - Панов Артем (локализация)</x:String>
    <x:String x:Key="Language.Russian">Русский</x:String>
    <x:String x:Key="Language.English">Английский</x:String>
    <x:String x:Key="Language.Caption">Язык интерфейса:</x:String>

    <!-- Вкладки -->
    <x:String x:Key="Tab.DefaultBinding">Привязка по умолчанию</x:String>
    <x:String x:Key="Tab.TwoWayBinding">Двухсторонняя привязка</x:String>
    <x:String x:Key="Tab.OneTimeBinding">Одноразовая привязка</x:String>
    <x:String x:Key="Tab.OneWayBinding">Односторонняя привязка</x:String>
    <x:String x:Key="Tab.Triggers">Триггеры</x:String>

    <!-- DefaultBindingView -->
    <x:String x:Key="Default.Title">1. Привязка по умолчанию</x:String>
    <x:String x:Key="Default.Group.TextBox">TextBox (TwoWay по умолчанию)</x:String>
