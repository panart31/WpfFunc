    <x:String x:Key="Default.Group.Time">TextBlock (OneWay по умолчанию)</x:String>
    <x:String x:Key="Default.Button.Update">Обновить</x:String>
    <x:String x:Key="Default.Group.DirectVsVm">Прямая привязка vs через ViewModel</x:String>
    <x:String x:Key="Default.Text.DirectBinding">Прямая привязка элементов:</x:String>
    <x:String x:Key="Default.Text.VmBinding">Привязка через ViewModel:</x:String>

    <!-- Сообщение -->
    <x:String x:Key="Message.ItemAdded">Добавлен элемент списка</x:String>
    <x:String x:Key="Message.Caption">Информация</x:String>

</ResourceDictionary>

